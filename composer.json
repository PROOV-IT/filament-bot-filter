{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "proovit/filament-url-watcher",
    "description": "Filament 5 admin plugin for browsing, classifying, and monitoring URL watcher incidents from proovit/laravel-url-watcher.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "proovit/laravel-url-watcher": "dev-dev@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.29.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1.22"
    },
    "autoload": {
        "psr-4": {
            "Proovit\\FilamentUrlWatcher\\": "src/",
            "Proovit\\FilamentUrlWatcher\\Database\\Factories\\": "database/factories/",
            "Proovit\\FilamentUrlWatcher\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../laravel-url-watcher",
            "options": {
                "symlink": true
            }
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Proovit\\FilamentUrlWatcher\\FilamentUrlWatcherServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": [
            "@php vendor/bin/pint src tests"
        ],
        "format:test": [
            "@php vendor/bin/pint --test src tests"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse src tests --ansi --memory-limit=1G"
        ],
        "qa": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
